// TLS for sysl at both ends, as a byte-stream transformer.
//
// **OpenSSL is never given the socket.** It is given a pair of in-memory buffers: ciphertext the
// program received goes in one end, plaintext comes out; plaintext the program wants to send goes
// in, ciphertext comes out to be written. TLS is then a *transformation*, and the question of how
// bytes reach the wire stays entirely the caller's.
//
// **That is Node's arrangement and it is the reason this package composes with anything.** Node's
// `tls.TLSSocket` wraps a `net.Socket` rather than replacing it, for the same reason: an event loop
// already owns the socket, and a TLS layer that insisted on owning one too could not be used from
// inside it. Here it means one binding serves a blocking fetch, a libuv connection and a test with
// no socket at all -- and the test is not a lesser case, because the whole protocol can be driven
// between two `Stream`s in memory.
//
// **It is also why a server cost almost nothing.** A `Stream` never asks which end it is, so
// `accept` is `connect` with one call changed and the connection tier below is shared entire.
//
// The loop a caller writes is three steps, **and the order is not free**:
//
//   1. Ask for progress -- `handshake`, `send` or `receive`.
//   2. Drain `outgoing` and write every byte of it to the socket.
//   3. On `Wants`, read from the socket and hand what came to `incoming`. Go back to 1.
//
// **Draining before the first ask writes nothing, and then both ends wait forever.** Nothing is in
// the outgoing buffer until something has been asked to produce it, so a loop that drains first
// sends no ClientHello and then blocks reading a socket the server is also blocked reading. It
// looks like a network fault and it is a loop written in the wrong order; the symptom is a
// connection that ends during the handshake with nothing having crossed it. Written down because it
// cost this package's own first live handshake.
//
// **`Wants` is one answer where OpenSSL has two.** It distinguishes "needs to read" from "needs to
// write", which matters to a caller that registers interest in one direction at a time; a caller
// that always drains `outgoing` and always feeds what arrives cannot use the difference, and every
// caller here does both. The distinction is recoverable from `Error.reason` if it is ever wanted.

module sh.sysl.openssl

import sh.sysl.openssl.c
import sysl.text.{cstring, from_cstring, from_utf8_unchecked}
import sysl.slices.as_ptr
import sysl.buf.{Buf, buf}

// What went wrong, in OpenSSL's own words where it has any.
//
// **Two numbers rather than one, because they answer different questions.** `reason` is
// `SSL_get_error`'s verdict on the call -- the protocol closed, the syscall failed, the library
// objected -- and `code` is the top of OpenSSL's own error queue, which is what carries "certificate
// has expired". A failure can have the first and not the second.
struct Error
    reason: i32
    code: u64
    message: string
end Error

impl Display for Error
    display(self, out: *Writer, fmt: FormatSpec) = display_str(self.message, out, fmt)

private[openssl] fail(reason: i32, what: string) -> Error
    val code = c.err_get_error()

    if code == 0 then return Error(reason, 0, what)

    var buf: [256]u8

    c.err_error_string_n(code, &buf[0], 256)

    from_cstring(&buf[0]) match
        Ok(text) -> Error(reason, code, s"${what}: ${text}")
        Err(_) -> Error(reason, code, what)
end fail

// How far a call got.
//
// **`Wants` is not a failure and must not be reported as one.** It is the ordinary answer whenever
// the protocol needs bytes moved, which during a handshake is most of the time.
enum Step
    Done
    Wants

// What `receive` found.
enum Received
    Data(n: usize)
    Wants

    // The peer closed the TLS session cleanly. **Distinct from the socket ending**, which the caller
    // sees and this cannot: a truncated stream with no close-notify is an attack in the general case
    // and is the caller's to notice.
    Closed
end Received

// What `send` managed.
enum Sent
    Took(n: usize)
    Wants
end Sent

// -- the context ----------------------------------------------------------------------------------

// The settings every connection under it shares: which protocol versions, and which certificates to
// trust. Made once.
//
// **It is a `&Client` because OpenSSL frees it and something has to say when.** `SSL_new` takes a
// reference on the context, so a connection outliving its context would be reading freed memory --
// which is why a `Stream` holds its client rather than only its pointer.
struct Client
    ctx: *c.SslCtx

    // Trust one more certificate authority, on top of the machine's own store.
    //
    // **Additive, and there is deliberately nothing here that lowers the bar.** A private authority,
    // a corporate root, or the self-signed certificate a test stands up are all the same case: more
    // is trusted, never less. The PEM may hold several, and every one of them is added.
    trust(&self, pem: []const u8) -> Result[unit, Error]
        if pem.len == 0 then return Err(Error(c.SSL_ERROR_SSL, 0, "there was nothing to trust"))

        val store = c.ctx_get_cert_store(self.ctx)

        if store == null then return Err(fail(c.SSL_ERROR_SSL, "this context has no trust store"))

        val bio = c.bio_new_mem_buf(as_ptr(pem), i32(pem.len))

        if bio == null then return Err(fail(c.SSL_ERROR_SSL, "could not read the certificate"))

        var found: usize = 0
        var trouble: Option[Error] = None

        loop
            val x = c.pem_read_bio_x509(bio, null, null, null)

            if x == null then break

            // **`add_cert` takes a reference of its own**, so the one handed over is still owed a
            // free -- and a duplicate is refused rather than counted, which is why the answer is
            // read but a repeat is not an error worth reporting.
            val rc = c.store_add_cert(store, x)

            c.x509_free(x)

            if rc != 1
                trouble = Some(fail(c.SSL_ERROR_SSL, "that certificate was refused"))
                break

            found += 1
        end loop

        c.bio_free(bio)

        trouble match
            Some(e) -> return Err(e)
            None -> ()

        if found == 0 then return Err(fail(c.SSL_ERROR_SSL, "there was no certificate in those bytes"))

        Ok(())
    end trust

    // Offer these application protocols, most preferred first.
    //
    // **The list is copied by OpenSSL here and is not on the server side**, which is the asymmetry
    // to know: a client hands over bytes and forgets them, a server hands over a pointer the
    // callback will read later.
    offer(&self, protocols: []const string) -> Result[unit, Error]
        val list = encode(protocols)?

        // **Zero is success.** Almost every other call in OpenSSL answers 1, and this one answers 0
        // -- a binding that checked for 1 would report every successful call as a failure.
        if c.ctx_set_alpn_protos(self.ctx, as_ptr(list.view()), u32(list.len())) != 0
            return Err(fail(c.SSL_ERROR_SSL, "the protocol list was refused"))

        Ok(())
    end offer
end Client

impl Drop for Client
    drop(self) = c.ctx_free(self.ctx)

// A TLS client trusting the machine's certificate store.
//
// **The store is the operating system's rather than one shipped here.** Go does this and Node does
// not -- Node compiles in a copy of Mozilla's list, which behaves identically everywhere and has to
// be kept current by whoever ships it. Asking the machine means a certificate the administrator
// added is trusted and an expiry the administrator applied is honoured, which for a package is the
// answer with no maintenance in it.
//
// **TLS 1.2 is the floor.** Everything below it is broken in ways that have names.
client() -> Result[&Client, Error]
    c.err_clear_error()

    val ctx = c.ctx_new(c.tls_client_method())

    if ctx == null then return Err(fail(c.SSL_ERROR_SSL, "could not make a TLS context"))

    val made = Client(ctx)

    // **A refusal here is not survivable, so it is reported rather than warned about.** A client
    // that could not load the trust store would verify nothing, and a TLS client that verifies
    // nothing is worse than no TLS client -- it looks secure.
    if c.ctx_set_default_verify_paths(ctx) != 1
        return Err(fail(c.SSL_ERROR_SSL, "could not read this machine's certificate store"))

    // Null is OpenSSL's own decision procedure. A callback here is how a program overrides it, and
    // this package deliberately offers no way to.
    c.ctx_set_verify(ctx, c.SSL_VERIFY_PEER, null)
    c.ctx_ctrl(ctx, c.SSL_CTRL_SET_MIN_PROTO_VERSION, i64(c.TLS1_2_VERSION), null)

    Ok(made)
end client

// -- one connection --------------------------------------------------------------------------------

// One TLS session, and the two buffers it is driven through.
struct Stream
    ssl: *c.Ssl

    // Ciphertext the caller received, on its way in. **Not freed here** -- see the `Drop` below.
    rbio: *c.Bio

    // Ciphertext to be written, on its way out.
    wbio: *c.Bio

    // Held so the context cannot be freed while this connection refers to it. **Private, and an
    // enum rather than one type**, because a `Stream` is the same object at both ends and the only
    // thing that differs is which context made it.
    private under: Under

    // Hand over ciphertext that arrived from the peer.
    incoming(&self, bytes: []const u8) -> Result[unit, Error]
        if bytes.len == 0 then return Ok(())

        val wrote = c.bio_write(self.rbio, &bytes[0], i32(bytes.len))

        if wrote < i32(bytes.len)
            return Err(fail(c.SSL_ERROR_SSL, "the TLS input buffer would not take what arrived"))

        Ok(())
    end incoming

    // Take ciphertext that has to be written to the peer. Answers how many bytes were put in `out`.
    //
    // **Call it until it answers zero, after every other call.** OpenSSL produces bytes to send from
    // reading as well as from writing -- an alert, a session ticket, a renegotiation -- so a caller
    // that only drained after `send` would stall.
    outgoing(&self, out: []u8) -> usize
        if out.len == 0 then return 0

        val got = c.bio_read(self.wbio, &out[0], i32(out.len))

        if got <= 0 then 0 else usize(got)
    end outgoing

    // How much is waiting to be written, for a caller sizing a buffer.
    waiting(self) -> usize = c.bio_ctrl_pending(self.wbio)

    // Drive the handshake as far as it will go.
    handshake(&self) -> Result[Step, Error]
        c.err_clear_error()

        val r = c.ssl_do_handshake(self.ssl)

        if r == 1 then return self.checked()

        self.step_of(r)
    end handshake

    // Whether the handshake finished and the certificate was acceptable.
    //
    // **Both, and the second is not implied by the first.** `SSL_VERIFY_PEER` makes a bad chain
    // abort the handshake, so this is a belt beside that brace -- and it is the check that would
    // still be here if a later version of this package ever grew a way to relax the first.
    private checked(&self) -> Result[Step, Error]
        // **A server asked for no certificate, so there is none to be unhappy about.** OpenSSL
        // answers `X509_V_OK` when it verified nothing, which would pass -- saying so here means
        // the check reads as deliberate rather than as something that happens to hold.
        self.under match
            AsServer(_) -> return Ok(Step.Done)
            AsClient(_) -> ()

        val verdict = c.ssl_get_verify_result(self.ssl)

        if verdict != c.X509_V_OK
            return Err(Error(c.SSL_ERROR_SSL, u64(verdict), s"the server's certificate was not acceptable (X509 code ${verdict})"))

        Ok(Step.Done)
    end checked

    // Give the peer some plaintext.
    send(&self, plaintext: []const u8) -> Result[Sent, Error]
        if plaintext.len == 0 then return Ok(Sent.Took(0))

        c.err_clear_error()

        val r = c.ssl_write(self.ssl, &plaintext[0], i32(plaintext.len))

        if r > 0 then return Ok(Sent.Took(usize(r)))

        self.step_of(r) match
            Ok(_) -> Ok(Sent.Wants)
            Err(e) -> Err(e)
    end send

    // Take whatever plaintext has arrived.
    receive(&self, out: []u8) -> Result[Received, Error]
        if out.len == 0 then return Ok(Received.Data(0))

        c.err_clear_error()

        val r = c.ssl_read(self.ssl, &out[0], i32(out.len))

        if r > 0 then return Ok(Received.Data(usize(r)))

        val reason = c.ssl_get_error(self.ssl, r)

        if reason == c.SSL_ERROR_ZERO_RETURN then return Ok(Received.Closed)

        self.step_of(r) match
            Ok(_) -> Ok(Received.Wants)
            Err(e) -> Err(e)
    end receive

    // Which application protocol the two ends agreed on, if they agreed on one.
    //
    // **Readable only once the handshake is done**, since it is settled inside it -- and `None` is
    // an ordinary answer rather than a failure: a client that offered nothing, or a peer that
    // supports no ALPN at all, leaves it unset and the connection is fine.
    protocol(&self) -> Option[string]
        var name: *u8 = ptr_cast(0usize)
        var len: u32 = 0

        c.ssl_get0_alpn_selected(self.ssl, &name, &len)

        if len == 0 then None else Some(from_utf8_unchecked(name[0..<usize(len)]))
    end protocol

    // Say goodbye. **Answered rather than insisted on**: a close-notify has to be written like
    // anything else, so the caller drains `outgoing` afterwards.
    close(&self) -> Step
        if c.ssl_shutdown(self.ssl) == 1 then Step.Done else Step.Wants
    end close

    // What a non-positive answer meant.
    //
    // **This is the one place `SSL_get_error` is read**, and everything above routes through it, so
    // there is one rule for what OpenSSL's `-1` means rather than five.
    private step_of(&self, r: i32) -> Result[Step, Error]
        val reason = c.ssl_get_error(self.ssl, r)

        if reason == c.SSL_ERROR_WANT_READ || reason == c.SSL_ERROR_WANT_WRITE
            return Ok(Step.Wants)

        if reason == c.SSL_ERROR_ZERO_RETURN
            return Err(fail(reason, "the peer closed the TLS session"))

        if reason == c.SSL_ERROR_SYSCALL
            return Err(fail(reason, "the connection under TLS failed"))

        Err(fail(reason, "TLS failed"))
    end step_of
end Stream

impl Drop for Stream
    // **`SSL_free` FREES BOTH BUFFERS, because `SSL_set_bio` took ownership of them.** Freeing them
    // here as well is a double free, and it is silent until it is not. This is OpenSSL's oldest
    // trap and the reason the two fields above say so.
    drop(self) = c.ssl_free(self.ssl)

// Which context a `Stream` is keeping alive. **Nothing reads which one it is** -- it exists so the
// context outlives the connections `SSL_new` took a reference for.
private[openssl] enum Under
    AsClient(of: &Client)
    AsServer(of: &Server)
end Under

// Begin a session with a named host.
//
// **The host is used twice and both are mandatory.** It goes out in the handshake as SNI, without
// which a shared server does not know which certificate to send -- GitHub answers nothing at all --
// and it is what the certificate's names are checked against, without which a valid certificate for
// any host would satisfy the verification.
connect(of: &Client, host: string) -> Result[&Stream, Error]
    c.err_clear_error()

    val ssl = c.ssl_new(of.ctx)

    if ssl == null then return Err(fail(c.SSL_ERROR_SSL, "could not begin a TLS session"))

    val rbio = c.bio_new(c.bio_s_mem())
    val wbio = c.bio_new(c.bio_s_mem())

    if rbio == null || wbio == null
        c.ssl_free(ssl)

        return Err(fail(c.SSL_ERROR_SSL, "could not make the buffers a TLS session is driven through"))
    end if

    // From here on the buffers belong to `ssl`, so every way out frees only that.
    c.ssl_set_bio(ssl, rbio, wbio)

    val name = cstring(host)

    if c.ssl_set1_host(ssl, name.ptr) != 1
        c.ssl_free(ssl)

        return Err(fail(c.SSL_ERROR_SSL, s"`${host}` is not a host name a certificate could be checked against"))
    end if

    c.ssl_ctrl(ssl, c.SSL_CTRL_SET_TLSEXT_HOSTNAME, i64(c.TLSEXT_NAMETYPE_host_name), name.ptr)
    c.ssl_set_connect_state(ssl)

    Ok(Stream(ssl, rbio, wbio, Under.AsClient(of)))
end connect

// -- the protocols on offer -------------------------------------------------------------------------

// The wire form of a protocol list: each name a length byte and then that many bytes.
//
// **Not a string with separators**, which is the shape a caller would guess at, so it is built here
// once and both ends use it.
private encode(protocols: []const string) -> Result[Buf[u8], Error]
    var out: Buf[u8] = buf()

    for name in protocols
        val bytes = name.bytes

        if bytes.len == 0 || bytes.len > 255
            return Err(Error(c.SSL_ERROR_SSL, 0, s"`${name}` is not a protocol name ALPN can carry"))

        out.push(u8(bytes.len))
        out.extend(bytes)

    Ok(out)
end encode

// -- a server ---------------------------------------------------------------------------------------

// The settings every connection this end accepts will share: the certificate to present, the key
// that goes with it, and the protocols on offer. Made once.
//
// **A `&Server` for the reason a `&Client` is one** -- `SSL_new` takes a reference on the context, so
// a connection must not outlive it -- and for a second one: the ALPN callback is handed this
// struct's own address, so it has to stay put.
struct Server
    ctx: *c.SslCtx

    // The protocol list, kept because OpenSSL is given a pointer into it rather than a copy.
    private protos: Buf[u8]

    // That pointer and its length, taken once. **Read by the callback instead of the `Buf`**, so
    // that nothing inside a C callback touches a container.
    private list: *u8
    private list_len: usize

    // Offer these application protocols, **most preferred first, and this end's order wins**.
    //
    // That is a choice rather than OpenSSL's: the server sees both lists and picks, so it may honour
    // either preference. A server's own order is the one to prefer, because it is the end that knows
    // which protocol it serves well.
    //
    // **The list is read later, from inside the handshake**, so it is kept on this struct -- which
    // is why a `Server` is a box and must not be copied.
    offer(&self, protocols: []const string) -> Result[unit, Error]
        self.protos = encode(protocols)?
        self.list = as_ptr(self.protos.view())
        self.list_len = self.protos.len()

        c.ctx_set_alpn_select_cb(self.ctx, &pick, ptr_cast(&*self))

        Ok(())
    end offer
end Server

// Choose a protocol, from inside the handshake.
//
// **`arg` is the `Server`'s own address**, which is how a C callback with no other way home finds
// its sysl value -- the same shape `sh.sysl.llhttp` uses, minus the offsetting, because OpenSSL has
// a user pointer to carry it.
//
// **What is written back must outlive the call**, so it points into the server's own list rather
// than at anything built here.
private pick(ssl: *c.Ssl, out: **u8, outlen: *u8, offered: *u8, offered_len: u32, arg: *u8) -> i32
    val sv: *Server = ptr_cast(arg)

    if sv.list_len == 0 || offered_len == 0 then return c.SSL_TLSEXT_ERR_NOACK

    val ours = sv.list[0..<sv.list_len]
    val theirs = offered[0..<usize(offered_len)]

    var i: usize = 0

    while i + 1 <= ours.len
        val n = usize(ours[i])

        if n == 0 || i + 1 + n > ours.len then break

        var j: usize = 0

        while j + 1 <= theirs.len
            val m = usize(theirs[j])

            if m == 0 || j + 1 + m > theirs.len then break

            if m == n && ours[(i + 1)..<(i + 1 + n)] == theirs[(j + 1)..<(j + 1 + m)]
                *out = ptr_cast(usize(sv.list) + i + 1)
                *outlen = u8(n)

                return c.SSL_TLSEXT_ERR_OK

            j += 1 + m

        i += 1 + n

    // **Refusing is right when both ends named protocols and none matched**, which is what RFC 7301
    // asks for: carrying on would leave the peer to guess what it is speaking to.
    c.SSL_TLSEXT_ERR_ALERT_FATAL
end pick

impl Drop for Server
    drop(self) = c.ctx_free(self.ctx)

// A TLS server presenting a certificate.
//
// **Both arguments are PEM bytes, not file names, and that is the package's shape rather than an
// oversight.** OpenSSL is never given the socket here; giving it the filesystem instead would be the
// same leak wearing a different hat. Bytes may have come from a file, a secret store, an environment
// variable or a test's own string, and this neither knows nor asks.
//
// **The certificate may be a chain, leaf first**, which is what a public certificate authority hands
// out and what a peer needs in order to build a path. Everything after the first is added as an
// intermediate.
//
// **TLS 1.2 is the floor**, as it is for a client.
server(certificate: []const u8, key: []const u8) -> Result[&Server, Error]
    c.err_clear_error()

    val ctx = c.ctx_new(c.tls_server_method())

    if ctx == null then return Err(fail(c.SSL_ERROR_SSL, "could not make a TLS context"))

    val made = Server(ctx, buf(), ptr_cast(0usize), 0)

    present(ctx, certificate)?
    unlock(ctx, key)?

    // **A key that does not go with the certificate is caught nowhere else.** Both calls above
    // succeed on a mismatched pair, and the handshake then fails at the *peer* with a decrypt error
    // that says nothing about this end at all.
    if c.ctx_check_private_key(ctx) != 1
        return Err(fail(c.SSL_ERROR_SSL, "the private key does not go with the certificate"))

    c.ctx_ctrl(ctx, c.SSL_CTRL_SET_MIN_PROTO_VERSION, i64(c.TLS1_2_VERSION), null)

    Ok(made)
end server

// Read the certificate chain and install it.
private present(ctx: *c.SslCtx, pem: []const u8) -> Result[unit, Error]
    if pem.len == 0 then return Err(Error(c.SSL_ERROR_SSL, 0, "the certificate is empty"))

    val bio = c.bio_new_mem_buf(as_ptr(pem), i32(pem.len))

    if bio == null then return Err(fail(c.SSL_ERROR_SSL, "could not read the certificate"))

    var found: usize = 0
    var trouble: Option[Error] = None

    loop
        // **Null means the end of the buffer as well as a bad object**, so the count below is what
        // separates "no certificates at all" from "three of them".
        val x = c.pem_read_bio_x509(bio, null, null, null)

        if x == null then break

        // The first is the leaf this end presents; the rest are the path to it. **`add1` takes a
        // reference of its own**, as `use_certificate` does, so both are followed by the free.
        val rc = if found == 0
            c.ctx_use_certificate(ctx, x)
        else
            i32(c.ctx_ctrl(ctx, c.SSL_CTRL_CHAIN_CERT, 1, ptr_cast(x)))

        c.x509_free(x)

        if rc != 1
            trouble = Some(fail(c.SSL_ERROR_SSL, "the certificate was refused"))
            break

        found += 1
    end loop

    c.bio_free(bio)

    trouble match
        Some(e) -> return Err(e)
        None -> ()

    if found == 0 then return Err(fail(c.SSL_ERROR_SSL, "there was no certificate in those bytes"))

    Ok(())
end present

// Read the private key and install it.
private unlock(ctx: *c.SslCtx, pem: []const u8) -> Result[unit, Error]
    if pem.len == 0 then return Err(Error(c.SSL_ERROR_SSL, 0, "the private key is empty"))

    val bio = c.bio_new_mem_buf(as_ptr(pem), i32(pem.len))

    if bio == null then return Err(fail(c.SSL_ERROR_SSL, "could not read the private key"))

    // **Null for the passphrase callback means OpenSSL prompts on a terminal**, which a server has
    // no business doing -- so an encrypted key is refused here rather than hanging a process. The
    // fourth argument being null is what makes the default callback read an empty passphrase and
    // fail, instead of asking.
    val key = c.pem_read_bio_private_key(bio, null, null, null)

    c.bio_free(bio)

    if key == null
        return Err(fail(c.SSL_ERROR_SSL, "there was no private key in those bytes, or it is encrypted"))

    val rc = c.ctx_use_private_key(ctx, key)

    c.pkey_free(key)

    if rc != 1 then return Err(fail(c.SSL_ERROR_SSL, "the private key was refused"))

    Ok(())
end unlock

// Take a session from a peer that is connecting.
//
// **`connect` with one call changed.** Nothing else about a `Stream` differs between the two ends --
// the memory buffers, the handshake, the reads and the writes are the same object -- which is what
// the memory-BIO shape buys and the reason this package did not have to grow a second one.
//
// **No host name and no verification.** A server presents a certificate rather than checking one,
// and asking a client for one is a different feature this package does not offer.
accept(of: &Server) -> Result[&Stream, Error]
    c.err_clear_error()

    val ssl = c.ssl_new(of.ctx)

    if ssl == null then return Err(fail(c.SSL_ERROR_SSL, "could not begin a TLS session"))

    val rbio = c.bio_new(c.bio_s_mem())
    val wbio = c.bio_new(c.bio_s_mem())

    if rbio == null || wbio == null
        c.ssl_free(ssl)

        return Err(fail(c.SSL_ERROR_SSL, "could not make the buffers a TLS session is driven through"))
    end if

    // From here on the buffers belong to `ssl`, so every way out frees only that.
    c.ssl_set_bio(ssl, rbio, wbio)
    c.ssl_set_accept_state(ssl)

    Ok(Stream(ssl, rbio, wbio, Under.AsServer(of)))
end accept
